{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "types": ["react", "react-native"]
  },
  "include": [
    "App.tsx",
    "src/markdown-editor.ts",
    "src/note-service.ts",
    "src/mobile/**/*.ts"
  ]
}